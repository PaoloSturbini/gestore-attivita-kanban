# Copy to .env only on X1 Pro and fill the passwords there.

# Public HTTPS endpoint handled by Cosmos.
COUCHDB_DOMAIN=pstdb.pst.my

# Admin account for the CouchDB container or existing CouchDB instance.
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-this-admin-password

# Database dedicated to Gestore attivita Kanban.
KANBAN_DB_NAME=gestore-attivita-kanban

# Least-privilege user used by the app for remote sync.
KANBAN_DB_USER=kanban_app
KANBAN_DB_PASSWORD=change-this-app-password

# Docker Compose expands $ in .env values. If a password contains $, write it
# as $$ here, or use a password without $.

# Local URL from X1 Pro. This isolated stack is bound on loopback port 5985.
COUCHDB_URL=http://127.0.0.1:5985
